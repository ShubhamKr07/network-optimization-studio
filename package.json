{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "harness:record": "pnpm --filter @workspace/scripts harness:record --",
    "e2e:gate": "pnpm --filter studio e2e:gate --",
    "e2e:quarantine": "pnpm --filter studio e2e:quarantine --",
    "smoke": "pnpm --filter @workspace/scripts smoke --",
    "harness:report": "pnpm --filter @workspace/scripts harness:report --",
    "docs:audit": "pnpm --filter @workspace/scripts docs:audit --",
    "docs:lint": "pnpm --filter @workspace/scripts docs:lint --"
  },
  "private": true,
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@rollup/rollup-darwin-arm64": "^4.62.2",
    "@tailwindcss/oxide-darwin-arm64": "4.3.0",
    "lightningcss-darwin-arm64": "^1.33.0",
    "prettier": "^3.8.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "0.27.3"
  }
}
