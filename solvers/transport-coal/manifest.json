{
  "id": "transport-coal",
  "name": "Coal Transport LP",
  "chapter": "Chapter 5",
  "datasetDir": "solvers/transport-coal/dataset",
  "countryBounds": { "sw": [29.76, -122.42], "ne": [47.61, -73.61] },
  "capabilities": { "supportsP": false, "capacityModes": ["per_mine"], "demandEditable": true, "outputGrids": ["flows", "costSummary", "serviceStats"], "supportsFacilityStatus": false },
  "distanceUnit": "mi",
  "tutor": {
    "readingList": [{ "kind": "book", "chapter": 5 }, { "kind": "notebook", "chapter": 5 }],
    "fixedQuestions": [
    { "id": "q1", "text": "What does a transportation model decide — and what does it not decide?", "tab": null },
    { "id": "q2", "text": "How do mine capacities and station demands constrain the flows?", "tab": "mines" },
    { "id": "q3", "text": "How do I read the Flows — which mine serves which station, and why?", "tab": "flows" }
    ]
  },
  "inputsSchema": {
    "type": "object",
    "properties": {
      "capacityFactor": { "type": "number", "exclusiveMinimum": 0 },
      "singleSource": { "type": "boolean" },
      "capacityInactive": { "type": "boolean" },
      "distanceBands": {
        "type": "array",
        "items": { "type": "number", "exclusiveMinimum": 0 },
        "minItems": 1
      },
      "gap": { "type": "number", "minimum": 0 },
      "timeLimitSec": { "type": "integer", "minimum": 1 },
      "mineCapacities": {
        "type": "object",
        "additionalProperties": { "type": "number", "minimum": 0 }
      },
      "stationDemands": {
        "type": "object",
        "additionalProperties": { "type": "number", "minimum": 0 }
      },
      "addedMines": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "city": { "type": "string" },
            "state": { "type": "string" },
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "capacity": { "type": ["number", "null"], "exclusiveMinimum": 0 }
          },
          "required": ["id", "city", "state", "lat", "lng"]
        }
      },
      "addedStations": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "city": { "type": "string" },
            "state": { "type": "string" },
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "demand": { "type": "number", "minimum": 0 }
          },
          "required": ["id", "city", "state", "lat", "lng", "demand"]
        }
      },
      "laneCostOverrides": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "fromId": { "type": "string", "minLength": 1 },
            "toId": { "type": "string", "minLength": 1 },
            "cost": { "type": "number", "exclusiveMinimum": 0 }
          },
          "required": ["fromId", "toId", "cost"]
        }
      }
    },
    "required": ["capacityFactor", "singleSource", "capacityInactive", "distanceBands", "gap", "timeLimitSec"]
  }
}
